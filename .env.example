# Copiá este archivo a .env.local (está en .gitignore) y completá tu token.
# Estas variables NO llevan prefijo VITE_: solo las lee el proxy de Vite (server/sabreProxy.ts)
# y el script smoke:live. Nunca llegan al JavaScript del browser.

# Token ATK de Sabre (vence a los 7 días). Pegalo sin el prefijo "Bearer".
SABRE_TOKEN=

# Servidor de Sabre. PROD por defecto (en este proyecto solo se hace shopping).
SABRE_BASE_URL=https://api.platform.sabre.com

# Opcional: si completás tu EPR, el proxy genera un token nuevo solo (OAuth v2)
# cuando falta SABRE_TOKEN o Sabre responde 401.
# SABRE_EPR=
# SABRE_PCC=
# SABRE_DOMAIN=AA
# SABRE_PASSWORD=

# PCC que se manda como customerCode (Flight Search) y pseudoCityCode (Flight Refresh).
# Flight Refresh lo exige: sin PCC, "Validar con Flight Refresh" no llama a Sabre.
# SABRE_REQUEST_PCC=

# Opcional: guardar respuestas reales en src/mocks/recorded/ para reproducirlas offline.
# SABRE_RECORD=1

# Modo de la app en el browser: live (Sabre real vía proxy) o mock (datos de ejemplo).
VITE_API_MODE=live
